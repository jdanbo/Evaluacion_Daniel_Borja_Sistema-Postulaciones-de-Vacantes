# =====================================================================
# Copia este archivo como .env y reemplaza los valores con los tuyos.
# El archivo .env NO se sube al repositorio (está en .gitignore).
# =====================================================================

# Puerto donde corre la API
PORT=3000

# Aquí se pone tu dirección URI de la base de datos PostgreSQL
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BD
# Ejemplo local: postgresql://postgres:tu_contraseña@localhost:5432/applications_db
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/applications_db
